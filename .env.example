# Push notifications — generate with:
#   docker run --rm node:22-alpine npx -y web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services (mailto: or https:)
VAPID_SUBJECT=mailto:you@example.com

# Header with the client address set by your reverse proxy
# (x-real-ip for nginx, cf-connecting-ip for Cloudflare). Empty without a proxy.
CHUVICKA_IP_HLAVICKA=

# Password needed to add a new phone (a parent phone opening the baby
# unit's QR code doesn't need it). Recommended when reachable from the internet.
CHUVICKA_HESLO=

# Upload limits in MB
#CHUVICKA_MAX_ZVUK_MB=20
#CHUVICKA_MAX_ZVUKY_MB=200
